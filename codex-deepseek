cat > "${LAUNCHER_PATH}" <<'PYEOF'
#!/usr/bin/env python3

import copy
import html
import json
import os
import re
import shutil
import sys
import urllib.error
import urllib.request
from pathlib import Path


CODEX_DIR = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
ENV_PATH = CODEX_DIR / "deepseek.env"
MODEL_CATALOG_PATH = CODEX_DIR / "model-catalogs" / "deepseek.json"
MODELS_CACHE_PATH = CODEX_DIR / "models_cache.json"
PROVIDER_NAME = "deepseek"
API_KEY_ENV = "DEEPSEEK_API_KEY"
DEFAULT_MODEL = "deepseek-v4-flash"
DEFAULT_REASONING_EFFORT = "high"
MODELS_ENDPOINT = "https://api.deepseek.com/models"
RESPONSES_REFERENCE_URL = "https://api-docs.deepseek.com/api/create-response/"


def find_real_codex() -> str:
    current = Path(__file__).resolve()
    candidates = [
        Path.home() / ".npm-global" / "bin" / "codex",
        Path("/opt/homebrew/bin/codex"),
        Path("/usr/local/bin/codex"),
    ]
    for candidate in candidates:
        if candidate.exists() and candidate.resolve() != current:
            return str(candidate)

    path_hit = shutil.which("codex")
    if path_hit and Path(path_hit).resolve() != current:
        return path_hit
    raise RuntimeError("real codex executable not found")


def load_dotenv(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.exists():
        return values
    for line in path.read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or "=" not in stripped:
            continue
        key, value = stripped.split("=", 1)
        values[key.strip()] = value.strip().strip("\"'")
    return values


def fetch_json(url: str, api_key: str) -> dict:
    request = urllib.request.Request(
        url,
        headers={
            "Authorization": f"Bearer {api_key}",
            "User-Agent": "codex-deepseek-launcher",
        },
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        return json.loads(response.read().decode("utf-8"))


def fetch_text(url: str) -> str:
    request = urllib.request.Request(
        url,
        headers={"User-Agent": "codex-deepseek-launcher"},
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        return response.read().decode("utf-8")


def extract_reference_values(page: str, property_name: str) -> list[str]:
    property_pattern = (
        rf'<strong class="openapi-schema__property">{re.escape(property_name)}</strong>'
        rf'.*?<strong>Possible values:</strong>\s*\[(.*?)\]</p>'
    )
    match = re.search(property_pattern, page, re.DOTALL)
    if not match:
        return []
    return [html.unescape(value) for value in re.findall(r"<code>([^<]+)</code>", match.group(1))]


def load_template() -> dict:
    for source in (MODEL_CATALOG_PATH, MODELS_CACHE_PATH):
        if not source.exists():
            continue
        try:
            models = json.loads(source.read_text(encoding="utf-8")).get("models", [])
        except (OSError, ValueError):
            continue
        if source == MODEL_CATALOG_PATH:
            candidate = next((item for item in models if isinstance(item, dict)), None)
        else:
            candidate = next(
                (
                    item
                    for preferred in ("gpt-5.4", "gpt-5.3-codex")
                    for item in models
                    if isinstance(item, dict) and item.get("slug") == preferred
                ),
                next((item for item in models if isinstance(item, dict)), None),
            )
        if candidate:
            return candidate
    return {}


def model_display_name(model_id: str) -> str:
    return "-".join(part.upper() if part == "v4" else part.title() for part in model_id.split("-"))


def build_model(model_id: str, efforts: list[str], template: dict, priority: int) -> dict:
    model = copy.deepcopy(template)
    model.update(
        {
            "slug": model_id,
            "display_name": model_display_name(model_id),
            "description": f"DeepSeek Responses API model: {model_id}",
            "default_reasoning_level": "high" if "high" in efforts else efforts[0],
            "supported_reasoning_levels": [
                {"effort": effort, "description": f"DeepSeek reasoning effort: {effort}"}
                for effort in efforts
            ],
            "visibility": "list",
            "supported_in_api": True,
            "priority": priority,
            "upgrade": None,
        }
    )
    model.pop("additional_speed_tiers", None)
    return model


def refresh_catalog(api_key: str) -> list[str]:
    payload = fetch_json(MODELS_ENDPOINT, api_key)
    provider_models = [
        item.get("id")
        for item in payload.get("data", [])
        if isinstance(item, dict) and item.get("id")
    ]
    reference = fetch_text(RESPONSES_REFERENCE_URL)
    responses_models = extract_reference_values(reference, "model")
    efforts = extract_reference_values(reference, "effort")
    model_ids = [model_id for model_id in provider_models if model_id in responses_models]
    if not model_ids:
        raise RuntimeError("official Responses API reference returned no available models")
    if not efforts:
        raise RuntimeError("official Responses API reference returned no reasoning effort values")

    template = load_template()
    models = [
        build_model(model_id, efforts, template, priority)
        for priority, model_id in enumerate(model_ids, start=1)
    ]
    temporary_path = MODEL_CATALOG_PATH.with_suffix(".tmp")
    temporary_path.write_text(
        json.dumps({"models": models}, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    temporary_path.replace(MODEL_CATALOG_PATH)
    return model_ids


def argv_has_config(argv: list[str], key: str) -> bool:
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in {"-c", "--config"} and i + 1 < len(argv):
            if argv[i + 1].startswith(f"{key}="):
                return True
            i += 2
            continue
        if arg.startswith("--config=") and f"{key}=" in arg:
            return True
        i += 1
    return False


def argv_has_model(argv: list[str]) -> bool:
    return (
        any(arg in {"-m", "--model"} or arg.startswith("--model=") for arg in argv)
        or argv_has_config(argv, "model")
    )


def build_exec_argv(real_codex: str, original_argv: list[str], default_model: str) -> list[str]:
    user_argv = original_argv[1:]
    argv = [
        real_codex,
        "-c",
        f"model_provider={json.dumps(PROVIDER_NAME)}",
        "-c",
        'preferred_auth_method="apikey"',
        "-c",
        'forced_login_method="api"',
    ]
    if not argv_has_model(user_argv):
        argv.extend(["-c", f"model={json.dumps(default_model)}"])
    if not argv_has_config(user_argv, "model_reasoning_effort"):
        argv.extend(["-c", f"model_reasoning_effort={json.dumps(DEFAULT_REASONING_EFFORT)}"])
    if not argv_has_config(user_argv, "model_catalog_json"):
        argv.extend(["-c", f"model_catalog_json={json.dumps(str(MODEL_CATALOG_PATH))}"])
    argv.extend(user_argv)
    return argv


def main() -> int:
    env = dict(os.environ)
    for key, value in load_dotenv(ENV_PATH).items():
        env.setdefault(key, value)
    if not env.get(API_KEY_ENV):
        print(
            f"codex-deepseek: missing {API_KEY_ENV}; set it in the shell or in {ENV_PATH}",
            file=sys.stderr,
        )
        return 1
    try:
        model_ids = refresh_catalog(env[API_KEY_ENV])
    except (OSError, ValueError, RuntimeError, urllib.error.URLError) as exc:
        if not MODEL_CATALOG_PATH.exists():
            print(f"codex-deepseek: failed to refresh model catalog: {exc}", file=sys.stderr)
            return 1
        print(f"codex-deepseek: model refresh failed, using cached catalog: {exc}", file=sys.stderr)
        model_ids = []

    default_model = DEFAULT_MODEL if DEFAULT_MODEL in model_ids or not model_ids else model_ids[0]

    try:
        real_codex = find_real_codex()
    except RuntimeError as exc:
        print(f"codex-deepseek: {exc}", file=sys.stderr)
        return 1

    os.execve(real_codex, build_exec_argv(real_codex, sys.argv, default_model), env)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
PYEOF

