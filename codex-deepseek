#!/bin/zsh
set -euo pipefail

# ===== 需要你自行编辑的关键内容 =====
# DeepSeek API Key：可以直接填入，也可以保持为空，安装后通过 DEEPSEEK_API_KEY 提供。
DEEPSEEK_API_KEY=""
# DeepSeek Responses API 官方地址。
DEEPSEEK_BASE_URL="https://api.deepseek.com/"
# 启动时会从 DeepSeek 官方接口刷新模型；此值仅作为首选和离线兜底。
DEEPSEEK_DEFAULT_MODEL="deepseek-v4-flash"
# ===== 通常不需要修改下面内容 =====

PROVIDER_NAME="deepseek"
PROVIDER_DISPLAY_NAME="deepseek"
API_KEY_ENV="DEEPSEEK_API_KEY"
WIRE_API="responses"
MINIMUM_CODEX_VERSION="0.144.0"

CODEX_DIR="${CODEX_HOME:-${HOME}/.codex}"
LOCAL_BIN="${HOME}/.local/bin"
CONFIG_PATH="${CODEX_DIR}/config.toml"
ENV_PATH="${CODEX_DIR}/${PROVIDER_NAME}.env"
MODEL_CATALOG_PATH="${CODEX_DIR}/model-catalogs/${PROVIDER_NAME}.json"
LAUNCHER_PATH="${LOCAL_BIN}/codex-${PROVIDER_NAME}"

mkdir -p "${LOCAL_BIN}" "${CODEX_DIR}/model-catalogs"

if ! command -v codex >/dev/null 2>&1; then
  echo "未检测到 codex，请先安装并启动官方 Codex。"
  exit 1
fi

if [ ! -f "${CONFIG_PATH}" ]; then
  echo "未检测到 ${CONFIG_PATH}，请先至少启动过一次官方 Codex。"
  exit 1
fi

CODEX_VERSION_OUTPUT="$(codex --version 2>/dev/null || true)"
python3 - "${CODEX_VERSION_OUTPUT}" "${MINIMUM_CODEX_VERSION}" <<'PY'
import re
import sys

current_text, minimum_text = sys.argv[1:3]
match = re.search(r"(\d+)\.(\d+)\.(\d+)", current_text)
if not match:
    raise SystemExit(f"无法识别 Codex 版本：{current_text or '无输出'}")
current = tuple(map(int, match.groups()))
minimum = tuple(map(int, minimum_text.split(".")))
if current < minimum:
    raise SystemExit(
        f"Codex {minimum_text} 或更高版本才支持 DeepSeek 官方方案；当前为 {match.group(0)}。"
    )
PY

export CONFIG_PATH PROVIDER_NAME PROVIDER_DISPLAY_NAME
export DEEPSEEK_BASE_URL API_KEY_ENV WIRE_API

python3 <<'PY'
import json
import os
import re
from pathlib import Path

config_path = Path(os.environ["CONFIG_PATH"])
provider_name = os.environ["PROVIDER_NAME"]

block = "\n".join(
    [
        f"[model_providers.{provider_name}]",
        f"name = {json.dumps(os.environ['PROVIDER_DISPLAY_NAME'])}",
        f"base_url = {json.dumps(os.environ['DEEPSEEK_BASE_URL'])}",
        f"wire_api = {json.dumps(os.environ['WIRE_API'])}",
        f"env_key = {json.dumps(os.environ['API_KEY_ENV'])}",
    ]
)

text = config_path.read_text(encoding="utf-8")
pattern = rf"(?ms)^\[model_providers\.{re.escape(provider_name)}\]\n.*?(?=^\[|\Z)"
replacement = block + "\n"

if re.search(pattern, text):
    text = re.sub(pattern, replacement, text)
else:
    if text and not text.endswith("\n"):
        text += "\n"
    if text and not text.endswith("\n\n"):
        text += "\n"
    text += replacement

for stale_section in (
    f"model_providers.{provider_name}.auth",
    f"profiles.{provider_name}",
):
    section_pattern = rf"(?ms)^\[{re.escape(stale_section)}\]\n.*?(?=^\[|\Z)"
    text = re.sub(section_pattern, "", text)

config_path.write_text(text, encoding="utf-8")
PY

# 空值重装时保留已有密钥，避免意外清空可用配置。
if [ -n "${DEEPSEEK_API_KEY}" ] || [ ! -f "${ENV_PATH}" ]; then
  cat > "${ENV_PATH}" <<EOF
# DeepSeek CLI credentials for codex-deepseek
# Auto-generated by codex-deepseek installer
${API_KEY_ENV}=${DEEPSEEK_API_KEY}
EOF
  chmod 600 "${ENV_PATH}"
fi

# 以本机 Codex 模型元数据为模板，并覆盖为 DeepSeek 官方公布的 Codex 参数。
python3 - "${MODEL_CATALOG_PATH}" "${CODEX_DIR}/models_cache.json" <<'PY'
