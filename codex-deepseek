#!/bin/zsh
set -euo pipefail

# ===== 需要你自行编辑的关键内容 =====
# DeepSeek API Key：填入你的 DeepSeek API Key。也可以保持为空，安装后通过环境变量 DEEPSEEK_API_KEY 提供。
DEEPSEEK_API_KEY=""
# DeepSeek API Base URL：官方 OpenAI 兼容地址通常保持这个值即可。
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# 默认模型：启动 codex-deepseek 时会自动注入这个模型，避免把全局 gpt-5.5 发给 DeepSeek。
DEEPSEEK_DEFAULT_MODEL="deepseek-v4-pro"
# 模型列表拉取失败时的兜底模型，多个模型用英文逗号分隔。
DEEPSEEK_FALLBACK_MODELS="deepseek-v4-pro,deepseek-v4-flash"
# 模型目录缓存时间，单位秒。
DEEPSEEK_CATALOG_TTL_SECONDS="300"
# ===== 通常不需要修改下面内容 =====

PROVIDER_NAME="deepseek"
PROVIDER_DISPLAY_NAME="DeepSeek"
API_KEY_ENV="DEEPSEEK_API_KEY"
WIRE_API="responses"

CODEX_HOME="${HOME}/.codex"
LOCAL_BIN="${HOME}/.local/bin"
CONFIG_PATH="${CODEX_HOME}/config.toml"
ENV_PATH="${CODEX_HOME}/${PROVIDER_NAME}.env"
LAUNCHER_PATH="${LOCAL_BIN}/codex-${PROVIDER_NAME}"

mkdir -p "${LOCAL_BIN}" "${CODEX_HOME}/model-catalogs"

if ! command -v codex >/dev/null 2>&1; then
  echo "未检测到 codex，请先在这台 Mac 上安装并确认官方 codex 可用。"
  exit 1
fi

if [ ! -f "${CONFIG_PATH}" ]; then
  echo "未检测到 ${CONFIG_PATH}，请先至少启动过一次官方 codex。"
  exit 1
fi

export CONFIG_PATH PROVIDER_NAME PROVIDER_DISPLAY_NAME DEEPSEEK_BASE_URL API_KEY_ENV WIRE_API

python3 <<'PY'
import json
import os
import re
from pathlib import Path

config_path = Path(os.environ["CONFIG_PATH"])
provider_name = os.environ["PROVIDER_NAME"]
provider_display_name = os.environ["PROVIDER_DISPLAY_NAME"]
base_url = os.environ["DEEPSEEK_BASE_URL"]
api_key_env = os.environ["API_KEY_ENV"]
wire_api = os.environ["WIRE_API"]

block = "\n".join(
    [
        f"[model_providers.{provider_name}]",
        f"name = {json.dumps(provider_display_name)}",
        f"base_url = {json.dumps(base_url)}",
        f"wire_api = {json.dumps(wire_api)}",
        f"env_key = {json.dumps(api_key_env)}",
    ]
)

text = config_path.read_text(encoding="utf-8")
pattern = rf"(?ms)^\[model_providers\.{re.escape(provider_name)}\]\n.*?(?=^\[|\Z)"
replacement = block + "\n"

if re.search(pattern, text):
    text = re.sub(pattern, replacement, text)
else:
    if text and not text.endswith("\n"):
        text += "\n"
    if text and not text.endswith("\n\n"):
        text += "\n"
    text += replacement

for stale_section in (
    f"model_providers.{provider_name}.auth",
    f"profiles.{provider_name}",
):
    section_pattern = rf"(?ms)^\[{re.escape(stale_section)}\]\n.*?(?=^\[|\Z)"
    text = re.sub(section_pattern, "", text)

config_path.write_text(text, encoding="utf-8")
PY

cat > "${ENV_PATH}" <<EOF
# DeepSeek CLI credentials for codex-deepseek
# Auto-generated by codex-deepseek installer
# 也可以不写入这里，改为在 shell 中 export ${API_KEY_ENV}=你的key
${API_KEY_ENV}=${DEEPSEEK_API_KEY}
EOF
chmod 600 "${ENV_PATH}"

cat > "${LAUNCHER_PATH}" <<'PYEOF'
#!/usr/bin/env python3

import copy
import json
import os
import shutil
import sys
import time
import tomllib
import urllib.error
import urllib.request
from pathlib import Path


CODEX_HOME = Path.home() / ".codex"
CONFIG_PATH = CODEX_HOME / "config.toml"
MODELS_CACHE_PATH = CODEX_HOME / "models_cache.json"
ENV_PATH = CODEX_HOME / "deepseek.env"
MODEL_CATALOG_PATH = CODEX_HOME / "model-catalogs" / "deepseek.json"
PROVIDER_NAME = "deepseek"
API_KEY_ENV = "DEEPSEEK_API_KEY"
DEFAULT_MODEL = "deepseek-v4-pro"
FALLBACK_MODELS = ["deepseek-v4-pro", "deepseek-v4-flash"]
CACHE_TTL_SECONDS = 300


def find_real_codex() -> str:
    current = Path(__file__).resolve()
    candidates = [
        Path.home() / ".npm-global" / "bin" / "codex",
        Path("/opt/homebrew/bin/codex"),
        Path("/usr/local/bin/codex"),
    ]
    for candidate in candidates:
        if candidate.exists() and candidate.resolve() != current:
            return str(candidate)

    path_hit = shutil.which("codex")
    if path_hit and Path(path_hit).resolve() != current:
        return path_hit

    raise RuntimeError("real codex executable not found")


def load_json(path: Path) -> dict:
    with path.open("r", encoding="utf-8") as handle:
        return json.load(handle)


def load_toml(path: Path) -> dict:
    with path.open("rb") as handle:
        return tomllib.load(handle)


def argv_has_config(argv: list[str], key: str) -> bool:
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in {"-c", "--config"} and i + 1 < len(argv):
            if argv[i + 1].startswith(f"{key}="):
                return True
            i += 2
            continue
        if arg.startswith("--config=") and f"{key}=" in arg:
            return True
        i += 1
    return False


def argv_has_model(argv: list[str]) -> bool:
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in {"-m", "--model"} and i + 1 < len(argv):
            return True
        if arg.startswith("--model="):
            return True
        i += 1
    return argv_has_config(argv, "model")


def load_dotenv(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.exists():
        return values

    for line in path.read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or "=" not in stripped:
            continue
        key, value = stripped.split("=", 1)
        values[key.strip()] = value.strip().strip("\"'")
    return values


def provider_config() -> dict:
    if not CONFIG_PATH.exists():
        raise RuntimeError(f"missing config file: {CONFIG_PATH}")

    config = load_toml(CONFIG_PATH)
    provider = config.get("model_providers", {}).get(PROVIDER_NAME)
    if not provider:
        raise RuntimeError(f"missing [model_providers.{PROVIDER_NAME}] in {CONFIG_PATH}")
    return provider


def ensure_api_key(env: dict[str, str]) -> str:
    api_key = env.get(API_KEY_ENV)
    if api_key:
        return api_key

    env.update(load_dotenv(ENV_PATH))
    api_key = env.get(API_KEY_ENV)
    if api_key:
        return api_key

    raise RuntimeError(f"missing {API_KEY_ENV}; set it in the shell or in {ENV_PATH}")


def fetch_provider_model_ids(base_url: str, api_key: str) -> list[str]:
    request = urllib.request.Request(
        base_url.rstrip("/") + "/models",
        headers={
            "Authorization": f"Bearer {api_key}",
            "User-Agent": "codex-deepseek-launcher",
        },
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        payload = json.loads(response.read().decode("utf-8"))

    items = payload.get("data") or payload.get("models") or []
    ids: list[str] = []
    for item in items:
        model_id = item.get("id") or item.get("slug") if isinstance(item, dict) else str(item)
        if model_id:
            ids.append(model_id)
    return ids


def load_cached_models() -> dict[str, dict]:
    if not MODELS_CACHE_PATH.exists():
        return {}
    cache = load_json(MODELS_CACHE_PATH)
    models = cache.get("models", [])
    return {
        model["slug"]: model
        for model in models
        if isinstance(model, dict) and model.get("slug")
    }


def remove_fast_tier(model: dict) -> dict:
    tiers = model.get("additional_speed_tiers")
    if not isinstance(tiers, list):
        return model
    filtered_tiers = [tier for tier in tiers if tier != "fast"]
    if filtered_tiers:
        model["additional_speed_tiers"] = filtered_tiers
    else:
        model.pop("additional_speed_tiers", None)
    return model


def synthesize_model_info(model_id: str, template: dict, priority: int) -> dict:
    model = copy.deepcopy(template)
    model["slug"] = model_id
    model["display_name"] = model_id
    model["visibility"] = "list"
    model["supported_in_api"] = True
    model["description"] = f"Provider-supported model for {PROVIDER_NAME}."
    model["priority"] = priority
    upgrade = model.get("upgrade")
    if isinstance(upgrade, dict) and upgrade.get("model") == template.get("slug"):
        upgrade["model"] = template.get("upgrade", {}).get("model", "gpt-5.4")
    return remove_fast_tier(model)


def build_custom_catalog(model_ids: list[str], cached_models: dict[str, dict]) -> dict:
    if not model_ids:
        model_ids = FALLBACK_MODELS
    if not cached_models:
        return {"models": [{"slug": model_id, "display_name": model_id} for model_id in model_ids]}

    fallback_template = cached_models.get("gpt-5.4") or next(iter(cached_models.values()))
    models: list[dict] = []
    for index, model_id in enumerate(model_ids, start=1):
        if model_id in cached_models:
            model = copy.deepcopy(cached_models[model_id])
            model["visibility"] = "list"
            model["supported_in_api"] = True
            models.append(remove_fast_tier(model))
        else:
            models.append(synthesize_model_info(model_id, fallback_template, index))
    return {"models": models}


def catalog_is_fresh() -> bool:
    if not MODEL_CATALOG_PATH.exists():
        return False
    age_seconds = time.time() - MODEL_CATALOG_PATH.stat().st_mtime
    return age_seconds <= CACHE_TTL_SECONDS


def ensure_catalog(base_url: str, api_key: str) -> bool:
    if catalog_is_fresh():
        return True

    try:
        model_ids = fetch_provider_model_ids(base_url, api_key)
    except (OSError, ValueError, urllib.error.URLError):
        model_ids = FALLBACK_MODELS

    cached_models = load_cached_models()
    catalog = build_custom_catalog(model_ids, cached_models)
    MODEL_CATALOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    MODEL_CATALOG_PATH.write_text(
        json.dumps(catalog, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    return True


def build_exec_argv(real_codex: str, original_argv: list[str], inject_catalog: bool) -> list[str]:
    argv = [real_codex, "-c", f"model_provider={json.dumps(PROVIDER_NAME)}"]
    if not argv_has_model(original_argv[1:]):
        argv.extend(["-c", f"model={json.dumps(DEFAULT_MODEL)}"])
    if inject_catalog and not argv_has_config(original_argv[1:], "model_catalog_json"):
        argv.extend(["-c", f"model_catalog_json={json.dumps(str(MODEL_CATALOG_PATH))}"])
    argv.extend(original_argv[1:])
    return argv


def main() -> int:
    try:
        real_codex = find_real_codex()
        provider = provider_config()
        base_url = provider.get("base_url")
        if not base_url:
            raise RuntimeError(f"missing base_url in [model_providers.{PROVIDER_NAME}]")
    except RuntimeError as exc:
        print(f"codex-deepseek: {exc}", file=sys.stderr)
        return 1

    env = dict(os.environ)
    try:
        api_key = ensure_api_key(env)
    except RuntimeError as exc:
        print(f"codex-deepseek: {exc}", file=sys.stderr)
        return 1

    inject_catalog = False
    if os.environ.get("CODEX_SKIP_MODEL_CATALOG") != "1":
        inject_catalog = ensure_catalog(base_url, api_key)

    os.execve(real_codex, build_exec_argv(real_codex, sys.argv, inject_catalog), env)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
PYEOF

