#!/usr/bin/env python3
import json
import os
import shutil
import socket
import subprocess
import sys
import time
from pathlib import Path

CODEX_HOME = Path.home() / ".codex"
CONFIG_PATH = CODEX_HOME / "config.toml"
ENV_PATH = CODEX_HOME / "deepseek.env"
BRIDGE_PATH = CODEX_HOME / "bin" / "codex-chat-bridge"
LOG_PATH = CODEX_HOME / "logs" / "codex-deepseek-bridge.log"
MODEL_CATALOG_PATH = CODEX_HOME / "model-catalogs" / "deepseek.json"
PROVIDER_NAME = "deepseek"
API_KEY_ENV = "DEEPSEEK_API_KEY"
REMOTE_BASE_URL = "https://api.deepseek.com"
DEFAULT_MODEL = "${DEEPSEEK_DEFAULT_MODEL}"
GLOBAL_DEFAULT_KEYS = ("model_provider", "model", "model_reasoning_effort")


def find_real_codex():
    current = Path(__file__).resolve()
    for candidate in [Path.home()/".npm-global/bin/codex", Path("/opt/homebrew/bin/codex"), Path("/usr/local/bin/codex")]:
        if candidate.exists() and candidate.resolve() != current:
            return str(candidate)
    hit = shutil.which("codex")
    if hit and Path(hit).resolve() != current:
        return hit
    raise RuntimeError("real codex executable not found")


def load_dotenv(path):
    values = {}
    if not path.exists():
        return values
    for line in path.read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or "=" not in stripped:
            continue
        key, value = stripped.split("=", 1)
        values[key.strip()] = value.strip().strip("\"'")
    return values


def has_config(argv, key):
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in {"-c", "--config"} and i + 1 < len(argv):
            if argv[i + 1].startswith(f"{key}="):
                return True
            i += 2
            continue
        if arg.startswith("--config=") and f"{key}=" in arg:
            return True
        i += 1
    return False


def has_model(argv):
    return any(arg in {"-m", "--model"} or arg.startswith("--model=") for arg in argv) or has_config(argv, "model")


def free_port():
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.bind(("127.0.0.1", 0))
        return str(sock.getsockname()[1])


def build_args(real_codex, original_argv, bridge_port):
    args = [
        real_codex,
        "-c",
        f"model_providers.{PROVIDER_NAME}.base_url={json.dumps(f'http://127.0.0.1:{bridge_port}/v1')}",
        "-c",
        f"model_provider={json.dumps(PROVIDER_NAME)}",
    ]
    if not has_model(original_argv[1:]):
        args.extend(["-c", f"model={json.dumps(DEFAULT_MODEL)}"])
    if not has_config(original_argv[1:], "model_catalog_json") and MODEL_CATALOG_PATH.exists():
        args.extend(["-c", f"model_catalog_json={json.dumps(str(MODEL_CATALOG_PATH))}"])
    args.extend(original_argv[1:])
    return args


def snapshot_global_defaults():
    if not CONFIG_PATH.exists():
        return {}
    defaults = {}
    for line in CONFIG_PATH.read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if stripped.startswith("["):
            break
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        if key in GLOBAL_DEFAULT_KEYS:
            defaults[key] = value.strip()
    return defaults


def restore_global_defaults(defaults):
    if not defaults or not CONFIG_PATH.exists():
        return
    lines = CONFIG_PATH.read_text(encoding="utf-8").splitlines()
    restored = []
    seen = set()
    inserted_missing = False

    for line in lines:
        stripped = line.strip()
        if stripped.startswith("[") and not inserted_missing:
            for key in GLOBAL_DEFAULT_KEYS:
                if key in defaults and key not in seen:
                    restored.append(f"{key} = {defaults[key]}")
                    seen.add(key)
            inserted_missing = True

        if not inserted_missing and "=" in line:
            key = line.split("=", 1)[0].strip()
            if key in defaults:
                restored.append(f"{key} = {defaults[key]}")
                seen.add(key)
                continue

        restored.append(line)

    if not inserted_missing:
        for key in GLOBAL_DEFAULT_KEYS:
            if key in defaults and key not in seen:
                restored.append(f"{key} = {defaults[key]}")

    CONFIG_PATH.write_text("\\n".join(restored) + "\\n", encoding="utf-8")


def main():
    global_defaults = snapshot_global_defaults()
    env = dict(os.environ)
    env.update(load_dotenv(ENV_PATH))
    api_key = env.get(API_KEY_ENV)
    if not api_key:
        print(f"codex-deepseek: missing {API_KEY_ENV}; set it in shell or {ENV_PATH}", file=sys.stderr)
        return 1
    if not BRIDGE_PATH.exists():
        print(f"codex-deepseek: missing bridge {BRIDGE_PATH}", file=sys.stderr)
        return 1

    bridge_port = free_port()
    bridge_env = dict(env)
    bridge_env.update({
        "CODEX_BRIDGE_REMOTE_BASE_URL": REMOTE_BASE_URL,
        "CODEX_BRIDGE_API_KEY": api_key,
        "CODEX_BRIDGE_PORT": bridge_port,
    })
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    log_handle = LOG_PATH.open("a", encoding="utf-8")
    log_handle.write(f"\\n--- starting codex-deepseek bridge on 127.0.0.1:{bridge_port} ---\\n")
    log_handle.flush()

    bridge = subprocess.Popen([sys.executable, str(BRIDGE_PATH)], env=bridge_env, stdout=log_handle, stderr=log_handle)
    time.sleep(0.5)
    if bridge.poll() is not None:
        print(f"codex-deepseek: bridge failed to start; see {LOG_PATH}", file=sys.stderr)
        log_handle.close()
        return 1

    try:
        return subprocess.run(build_args(find_real_codex(), sys.argv, bridge_port), env=env).returncode
    finally:
        restore_global_defaults(global_defaults)
        bridge.terminate()
        try:
            bridge.wait(timeout=3)
        except subprocess.TimeoutExpired:
            bridge.kill()
            bridge.wait(timeout=3)
        log_handle.close()


if __name__ == "__main__":
    raise SystemExit(main())
EOF

