#!/usr/bin/env bash
set -euo pipefail

# 可自行修改：DeepSeek bridge 日志路径。
LOG_FILE="${CODEX_DEEPSEEK_BRIDGE_LOG:-$HOME/.codex/logs/codex-deepseek-bridge.log}"

# 可自行修改：默认显示最近几条完成记录。
DEFAULT_LIMIT="${CODEX_DEEPSEEK_STATS_LIMIT:-5}"

usage() {
  cat <<'USAGE'
用法：
  codex-deepseek-stats          显示最近 5 条 DeepSeek 完成记录
  codex-deepseek-stats 20       显示最近 20 条 DeepSeek 完成记录
  codex-deepseek-stats --watch  实时观察 DeepSeek bridge 日志

输出字段：
  reasoning_effort     实际发给 DeepSeek 的推理强度 high/max
  reasoning_chars      DeepSeek 返回的隐藏思考字符数
  output_chars         最终回复字符数
  cache_hit_tokens     DeepSeek prompt cache 命中 token
  cache_miss_tokens    DeepSeek prompt cache 未命中 token
  cache_hit_rate       命中率，按 hit / (hit + miss) 计算
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ ! -f "$LOG_FILE" ]]; then
  echo "找不到日志文件：$LOG_FILE" >&2
  echo "先运行一次 codex-deepseek 后再查询。" >&2
  exit 1
fi

if [[ "${1:-}" == "--watch" || "${1:-}" == "-w" ]]; then
  tail -f "$LOG_FILE" | grep --line-buffered "responses completed"
  exit 0
fi

limit="${1:-$DEFAULT_LIMIT}"
if ! [[ "$limit" =~ ^[0-9]+$ ]]; then
  echo "条数必须是数字：$limit" >&2
  usage >&2
  exit 1
fi

records="$(grep "responses completed" "$LOG_FILE" || true)"
if [[ -z "$records" ]]; then
  echo "还没有 DeepSeek 完成记录。先运行一次 codex-deepseek 后再查询。" >&2
  exit 1
fi

printf '%s\n' "$records" | tail -n "$limit"
